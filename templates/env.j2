PIU_TRACKER_DATA_FILE=/config/tracker.json
PIU_TRACKER_LISTEN_ADDRESS=:{{ piu_tracker_container_http_port }}
PIU_TRACKER_BASE_PATH={{ piu_tracker_path_prefix }}
PIU_TRACKER_ART_CACHE_DIR=/data/art
PIU_TRACKER_ART_CUSTOM_DIR=/art
PIU_TRACKER_ART_FETCH_ENABLED={{ piu_tracker_art_fetch_enabled | bool | to_json }}
PIU_TRACKER_ART_SOURCES={{ piu_tracker_art_sources | join(',') }}
PIU_TRACKER_LOG_LEVEL={{ piu_tracker_log_level | lower }}
{% if piu_tracker_timezone %}
TZ={{ piu_tracker_timezone }}
{% endif %}

